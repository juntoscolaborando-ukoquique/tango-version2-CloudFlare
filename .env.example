# Copy this file to .env and fill in the values.
# NEVER commit .env — it is listed in .gitignore.

# GitHub
GITHUB_REPO_URL=https://github.com/<owner>/<repo>
GITHUB_TOKEN=ghp_...                      # fine-grained PAT: Contents write on this repo

# Telegram (legacy transport — CLI and Python tests)
TELEGRAM_BOT_TOKEN=                        # from @BotFather
TELEGRAM_CHAT_ID=                          # numeric chat ID

# Cipher (Python CLI / local tests only — CI injects these as Actions secrets)
CIFRADO_SALT=47                            # numeric offset; use a secret value in production
CLAVE_DESPLIEGUE=                          # high-entropy passphrase for AES-256-GCM bundle

# Cloudflare Worker (set after running wrangler deploy)
CLOUDFLARE_WORKER_URL=                     # e.g. https://tango-cifrado-worker.<account>.workers.dev
ADMIN_BOOTSTRAP_TOKEN=                     # wrangler secret put ADMIN_BOOTSTRAP_TOKEN
