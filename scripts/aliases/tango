#!/usr/bin/env bash
# tango — abre la PWA publicada de Tango Cifrado en el navegador predeterminado.
# Evita tener que escribir la URL larga a mano:
#   https://misbusquedaspersonales-cyber.github.io/tango_cipher_bot_public/pwa/index.html
set -euo pipefail

TANGO_URL="https://misbusquedaspersonales-cyber.github.io/tango_cipher_bot_public/pwa/index.html"

# Short URL (necesita que los redirects del repo root estén pusheados a GH Pages):
#   https://misbusquedaspersonales-cyber.github.io/tango_cipher_bot_public/
TANGO_SHORT_URL="https://misbusquedaspersonales-cyber.github.io/tango_cipher_bot_public/"

if [ "${1:-}" = "--short" ] || [ "${1:-}" = "-s" ]; then
  TARGET="$TANGO_SHORT_URL"
else
  TARGET="$TANGO_URL"
fi

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$TARGET" >/dev/null 2>&1 &
elif command -v open >/dev/null 2>&1; then
  open "$TARGET" >/dev/null 2>&1 &
elif command -v start >/dev/null 2>&1; then
  # Windows (Git Bash / WSL)
  start "" "$TARGET" >/dev/null 2>&1
else
  echo "Navegador no detectado. Abrí manualmente:"
  echo "  $TARGET"
  exit 1
fi

echo "✅ Abriendo Tango Cifrado → $TARGET"

